# Copy this file to `.env.local` and fill in your keys.
# `.env.local` is gitignored — your real keys are never committed.

# Which AI provider to use: "huggingface" (free, default) or "anthropic" (Claude, needs API key)
AI_PROVIDER=huggingface

# --- Hugging Face (free dev provider) ---
# Get a token at https://hf.co/settings/tokens
HF_TOKEN=

# Text model used for the creature's chat personality
HF_TEXT_MODEL=meta-llama/Llama-3.2-3B-Instruct
# Image model used to generate each creature's unique avatar
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Anthropic Claude (target provider — add later) ---
# Pay-as-you-go key from https://console.anthropic.com (separate from Claude Max!)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
